# Copy to .env. Real environment variables override these.

PORT=8090
# Public address customers use. Sadad sends the customer back to APP_URL/payment/callback.
APP_URL=http://localhost:8090

# IRT = amounts entered in Toman (sent to Sadad ×10 as Rial), IRR = amounts in Rial
CURRENCY=IRT

# Password for /admin (transactions list). Leave empty to disable the password (not recommended).
ADMIN_USER=admin
ADMIN_PASSWORD=admin123

# sandbox = built-in test bank, no real money, no credentials needed
# live    = real https://sadad.shaparak.ir with the credentials below
SADAD_MODE=sandbox

# Real credentials from Bank Melli / Sadad (live mode only)
SADAD_MERCHANT_ID=
SADAD_TERMINAL_ID=
SADAD_TERMINAL_KEY=
