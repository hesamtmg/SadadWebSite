# Copy to .env and adjust. docker compose reads .env automatically.

# --- Ports on your computer ---
WP_PORT=8080
SADAD_SANDBOX_PORT=8081
SITE_URL=http://localhost:8080

# --- Admin login (change these!) ---
ADMIN_USER=admin
ADMIN_PASSWORD=admin123
ADMIN_EMAIL=admin@example.com
SITE_TITLE=فروشگاه نمونه سداد

# --- Store ---
WP_LOCALE=fa_IR
WOOCOMMERCE_VERSION=11.2.1
# IRT = Toman (the gateway multiplies by 10 before sending Rial to Sadad), IRR = Rial
STORE_CURRENCY=IRT
SHIPPING_COST=95000
FREE_SHIPPING_MIN=3000000

# --- Database ---
DB_NAME=wordpress
DB_USER=wordpress
DB_PASSWORD=wordpress
DB_ROOT_PASSWORD=rootpass

# --- Sadad gateway ---
# sandbox = local test bank on SADAD_SANDBOX_PORT (any card works, no real money).
#           Uses the SANDBOX_* credentials below; your real ones are ignored.
# live    = real https://sadad.shaparak.ir. Needs your real credentials below
#           and a server Sadad can reach (public domain, usually an Iranian IP).
SADAD_MODE=sandbox

# Real credentials from Bank Melli / Sadad (used only in live mode).
# When set, they are written into the gateway on every `docker compose up -d`.
# Leave empty to manage them in Admin → پرداخت الکترونیک سداد → تنظیمات درگاه instead.
SADAD_MERCHANT_ID=
SADAD_TERMINAL_ID=
SADAD_TERMINAL_KEY=

# Sandbox-only test credentials shared by the store and the mock bank. Never sent to Sadad.
SANDBOX_MERCHANT_ID=000000140336964
SANDBOX_TERMINAL_ID=24095674
SANDBOX_TERMINAL_KEY=O0hoZrcZPeGRqEEMRuwJlmuBSaVkmpEu
