# Copy to .env and adjust. docker compose reads .env automatically.

# --- Ports on your computer ---
WP_PORT=8080
SADAD_SANDBOX_PORT=8081
SITE_URL=http://localhost:8080

# --- Admin login (change these!) ---
ADMIN_USER=admin
ADMIN_PASSWORD=admin123
ADMIN_EMAIL=admin@example.com
SITE_TITLE=فروشگاه نمونه سداد

# --- Store ---
WP_LOCALE=fa_IR
WOOCOMMERCE_VERSION=11.2.1
# IRT = Toman (the gateway multiplies by 10 before sending Rial to Sadad), IRR = Rial
STORE_CURRENCY=IRT
SHIPPING_COST=95000
FREE_SHIPPING_MIN=3000000

# --- Database ---
DB_NAME=wordpress
DB_USER=wordpress
DB_PASSWORD=wordpress
DB_ROOT_PASSWORD=rootpass

# --- Sadad gateway ---
# sandbox = local test bank on SADAD_SANDBOX_PORT (any card works, no real money)
# live    = real https://sadad.shaparak.ir — needs your real credentials below
#           and a server Sadad can reach (public domain, usually an Iranian IP)
SADAD_MODE=sandbox
SADAD_MERCHANT_ID=000000140336964
SADAD_TERMINAL_ID=24095674
# Base64 key, 24 bytes after decoding. This one is a random test key for the sandbox only.
SADAD_TERMINAL_KEY=O0hoZrcZPeGRqEEMRuwJlmuBSaVkmpEu
